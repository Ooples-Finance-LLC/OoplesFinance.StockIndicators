<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net8.0;net461</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="'$(IndicatorPackageVersion)' == ''">
    <ProjectReference Include="../../src/OoplesFinance.StockIndicators.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(IndicatorPackageVersion)' != ''">
    <!-- Release verification restores the package being published, not a project rebuild. -->
    <PackageReference Include="OoplesFinance.StockIndicators" Version="[$(IndicatorPackageVersion)]" />
  </ItemGroup>
  <!-- These check the exact routes' contracts - bit-for-bit values, owned history, validation order - so a
       builder here starts in the exact mode. A test of the fast mode asks for it by name. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="OoplesFinance.StockIndicators.DefaultNumerics" Value="Exact" />
  </ItemGroup>
</Project>
