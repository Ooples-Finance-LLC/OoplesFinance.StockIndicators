<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The FXMacroData client lives in its own library rather than inside the DevConsole executable.

    The tests exercise this client directly, and referencing an Exe from the unit-test project meant
    the whole test suite took a build dependency on a sample application - an unrelated break in the
    example would have failed the tests, and the example's dependencies flowed into the test
    assembly. Reaching the client also required InternalsVisibleTo pointed at the test project from
    an executable, which is a strange direction for visibility to run.

    A small library referenced by both the console and the tests removes all of that, and keeps the
    provider code out of the indicator package itself.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OoplesFinance.StockIndicators.csproj" />
  </ItemGroup>

</Project>
