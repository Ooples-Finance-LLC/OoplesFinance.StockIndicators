<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0;net461</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Emit source generator output files for debugging -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <NeutralLanguage>en-US</NeutralLanguage>
    <Description>Largest C# stock indicator library with over 750 to choose from and easiest to use with abilities such as making an indicator out of any other indicator or using any moving average with any indicator. </Description>
    <Version>1.1.0</Version>
    <Authors>ooples</Authors>
    <Company>Ooples Finance</Company>
    <RepositoryUrl>https://github.com/ooples/OoplesFinance.StockIndicators</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReleaseNotes>https://github.com/ooples/OoplesFinance.StockIndicators/releases</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/ooples/OoplesFinance.StockIndicators</PackageProjectUrl>
    <PackageTags>stock; stocks; technical; indicators; market; markets; analysis; library; finance; financial; indicator; moving average; algorithm; algorithms; trading; trades; algorithmic; ai; trade; indicators; technical indicators; technical analysis; stock indicators; crypto; bitcoin, cryptocurrency; forex; adaptive; kaufman; rsi; simple; weighted; exponential; moving; average; equity; strategy; chart; charting; mfi; cmf; relative; strength; index; volume; open; high; low; close; typical price; stochastic; adx; directional; reverse; trailing stop; pivot points; pivot; points; ultimate; ulcer; correlation; slope; cycle; standard; macd; schaff; ehlers; john ehlers; package; library; .net; c#; obv; nvi; pvi; beta; standard; deviation; bull; bear; smoothed; smooth; smoothing; chandelier; exit; atr; aroon; bollinger; bollinger bands; bands; price channels; hilbert; transform; chaikin; wilder; welles wilder; williams; larry williams; money; flow; parabolic; donchian; keltner; channel; alligator; gator; supertrend; fractal; chaos; oscillators; choppiness</PackageTags>
    <Copyright>Ooples Finance LLC 2021-2022</Copyright>
    <PackageIcon>Favicon.jpg</PackageIcon>
    <AutoGenerateBindingRedirects>True</AutoGenerateBindingRedirects>
    <UseWindowsForms>False</UseWindowsForms>
    <UseWPF>False</UseWPF>
    <GenerateDocumentationFile>False</GenerateDocumentationFile>
    <SignAssembly>True</SignAssembly>
    <Title>Ooples Finance Stock Indicators</Title>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
    <Optimize>False</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
    <Optimize>True</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0|AnyCPU'">
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0|AnyCPU'">
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net461|AnyCPU'">
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net461|AnyCPU'">
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="bin\**" />
    <EmbeddedResource Remove="bin\**" />
    <None Remove="bin\**" />
    <!-- Exclude source generator files from main project compilation -->
    <Compile Remove="SourceGeneration\**" />
    <None Remove="SourceGeneration\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Example.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Calculations\eladq3fp.fhq~" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LinqOptimizer.CSharp" Version="0.7.0" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <!-- Upstream fix (to PR back to pr87): the Builder/Trading + Builder/MarketData
         Alpaca adapters use Alpaca.Markets but the reference was missing. -->
    <PackageReference Include="Alpaca.Markets" Version="7.1.4" />
    <PackageReference Include="Alpaca.Markets.Extensions" Version="7.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fork: grant ONLY the platform's indicator adapter access to the internal,
         deprecated reflection breadth-engine (IndicatorInvoker) instead of making
         it public. Keeps it out of the library's public API. -->
    <InternalsVisibleTo Include="Ooples.Indicators" />
  </ItemGroup>

  <!-- Source Generator: Build the generator project first -->
  <ItemGroup>
    <ProjectReference Include="SourceGeneration\OoplesFinance.StockIndicators.SourceGeneration.csproj"
                      ReferenceOutputAssembly="false"
                      SetTargetFramework="TargetFramework=netstandard2.0"
                      PrivateAssets="all" />
  </ItemGroup>

  <!-- Source Generator: Reference the built analyzer DLL -->
  <ItemGroup>
    <Analyzer Include="SourceGeneration\bin\$(Configuration)\netstandard2.0\OoplesFinance.StockIndicators.SourceGeneration.dll" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='net461'">
    <PackageReference Include="System.Memory" Version="4.6.0" />
    <PackageReference Include="System.Buffers" Version="4.6.0" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Text.Json" Version="6.0.11" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="Images\Favicon.jpg">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
