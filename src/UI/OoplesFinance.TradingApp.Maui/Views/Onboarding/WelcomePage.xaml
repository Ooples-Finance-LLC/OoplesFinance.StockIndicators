<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OoplesFinance.TradingApp.Maui.Views.Onboarding.WelcomePage"
             Title="Welcome"
             BackgroundColor="{StaticResource Background}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="Center">

            <!-- Logo/Icon -->
            <Border BackgroundColor="{StaticResource Primary}"
                    WidthRequest="100"
                    HeightRequest="100"
                    HorizontalOptions="Center"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="50"/>
                </Border.StrokeShape>
                <Label Text="OT"
                       FontSize="36"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>

            <!-- Welcome Text -->
            <Label Text="Ooples Trading"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   HorizontalOptions="Center"/>

            <Label Text="Your intelligent trading companion that adapts to your experience level and helps you achieve your financial goals."
                   FontSize="15"
                   TextColor="{StaticResource TextMuted}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,10"/>

            <!-- Feature Cards -->
            <Border Style="{StaticResource CardStyle}" Padding="20">
                <VerticalStackLayout Spacing="18">

                    <!-- Feature 1 -->
                    <HorizontalStackLayout Spacing="15">
                        <Border BackgroundColor="{StaticResource Success}"
                                WidthRequest="44"
                                HeightRequest="44"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="22"/>
                            </Border.StrokeShape>
                            <Label Text="1"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Personalized Experience"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Label Text="UI adapts to your skill level"
                                   FontSize="13"
                                   TextColor="{StaticResource TextMuted}"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <!-- Feature 2 -->
                    <HorizontalStackLayout Spacing="15">
                        <Border BackgroundColor="{StaticResource Primary}"
                                WidthRequest="44"
                                HeightRequest="44"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="22"/>
                            </Border.StrokeShape>
                            <Label Text="2"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="AI-Powered Trading"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Label Text="Smart algorithms for your portfolio"
                                   FontSize="13"
                                   TextColor="{StaticResource TextMuted}"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <!-- Feature 3 -->
                    <HorizontalStackLayout Spacing="15">
                        <Border BackgroundColor="{StaticResource Warning}"
                                WidthRequest="44"
                                HeightRequest="44"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="22"/>
                            </Border.StrokeShape>
                            <Label Text="3"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Risk Protection"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Label Text="Built-in safeguards and limits"
                                   FontSize="13"
                                   TextColor="{StaticResource TextMuted}"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Get Started Button -->
            <Button Text="Get Started"
                    Style="{StaticResource PrimaryButton}"
                    Clicked="OnGetStartedClicked"
                    HorizontalOptions="Fill"
                    HeightRequest="55"
                    FontSize="18"
                    Margin="0,10,0,0"/>

            <!-- Already have account -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                <Label Text="Already have an account?"
                       FontSize="14"
                       TextColor="{StaticResource TextMuted}"/>
                <Label Text="Sign In"
                       FontSize="14"
                       TextColor="{StaticResource Primary}"
                       TextDecorations="Underline">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSignInTapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
