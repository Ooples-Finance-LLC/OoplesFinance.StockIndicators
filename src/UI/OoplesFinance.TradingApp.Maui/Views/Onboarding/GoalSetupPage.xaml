<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OoplesFinance.TradingApp.Maui.Views.Onboarding.GoalSetupPage"
             Title="Set Your Goal"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20">

        <!-- Progress Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="10" Margin="0,0,0,20">
            <Label Text="Step 2 of 3: Financial Goal"
                   FontSize="14"
                   TextColor="{StaticResource TextMuted}"/>
            <ProgressBar Progress="0.66"
                         ProgressColor="{StaticResource Primary}"
                         HeightRequest="6"/>
        </VerticalStackLayout>

        <!-- Goal Selection -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20">

                <Label Text="What are you investing for?"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"
                       HorizontalTextAlignment="Center"/>

                <!-- Goal Options Grid -->
                <FlexLayout Wrap="Wrap"
                            JustifyContent="SpaceEvenly"
                            AlignItems="Center">

                    <!-- Retirement -->
                    <Border x:Name="RetirementGoal"
                            BackgroundColor="{StaticResource Surface}"
                            Stroke="{StaticResource BorderColor}"
                            StrokeThickness="1"
                            WidthRequest="140"
                            HeightRequest="130"
                            Margin="8"
                            Padding="15">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGoalSelected" CommandParameter="Retirement"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                            <Label Text="[Beach]"
                                   FontSize="32"
                                   HorizontalOptions="Center"/>
                            <Label Text="Retirement"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Home Purchase -->
                    <Border x:Name="HomeGoal"
                            BackgroundColor="{StaticResource Surface}"
                            Stroke="{StaticResource BorderColor}"
                            StrokeThickness="1"
                            WidthRequest="140"
                            HeightRequest="130"
                            Margin="8"
                            Padding="15">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGoalSelected" CommandParameter="Home"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                            <Label Text="[Home]"
                                   FontSize="32"
                                   HorizontalOptions="Center"/>
                            <Label Text="Home Purchase"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Education -->
                    <Border x:Name="EducationGoal"
                            BackgroundColor="{StaticResource Surface}"
                            Stroke="{StaticResource BorderColor}"
                            StrokeThickness="1"
                            WidthRequest="140"
                            HeightRequest="130"
                            Margin="8"
                            Padding="15">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGoalSelected" CommandParameter="Education"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                            <Label Text="[Grad]"
                                   FontSize="32"
                                   HorizontalOptions="Center"/>
                            <Label Text="Education"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Emergency Fund -->
                    <Border x:Name="EmergencyGoal"
                            BackgroundColor="{StaticResource Surface}"
                            Stroke="{StaticResource BorderColor}"
                            StrokeThickness="1"
                            WidthRequest="140"
                            HeightRequest="130"
                            Margin="8"
                            Padding="15">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGoalSelected" CommandParameter="Emergency"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                            <Label Text="[Safe]"
                                   FontSize="32"
                                   HorizontalOptions="Center"/>
                            <Label Text="Emergency Fund"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Wealth Growth -->
                    <Border x:Name="GrowthGoal"
                            BackgroundColor="{StaticResource Surface}"
                            Stroke="{StaticResource BorderColor}"
                            StrokeThickness="1"
                            WidthRequest="140"
                            HeightRequest="130"
                            Margin="8"
                            Padding="15">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGoalSelected" CommandParameter="Growth"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                            <Label Text="[Chart]"
                                   FontSize="32"
                                   HorizontalOptions="Center"/>
                            <Label Text="Wealth Growth"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Custom Goal -->
                    <Border x:Name="CustomGoal"
                            BackgroundColor="{StaticResource Surface}"
                            Stroke="{StaticResource BorderColor}"
                            StrokeThickness="1"
                            WidthRequest="140"
                            HeightRequest="130"
                            Margin="8"
                            Padding="15">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGoalSelected" CommandParameter="Custom"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                            <Label Text="[Star]"
                                   FontSize="32"
                                   HorizontalOptions="Center"/>
                            <Label Text="Custom Goal"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>

                </FlexLayout>

                <!-- Goal Details (shown after selection) -->
                <Border x:Name="GoalDetailsFrame"
                        Style="{StaticResource CardStyle}"
                        Padding="20"
                        IsVisible="False"
                        Margin="0,10,0,0">
                    <VerticalStackLayout Spacing="15">

                        <Label Text="Target Amount"
                               FontSize="13"
                               TextColor="{StaticResource TextMuted}"/>
                        <Entry x:Name="TargetAmountEntry"
                               Placeholder="$50,000"
                               Keyboard="Numeric"
                               FontSize="16"
                               TextColor="{StaticResource TextPrimary}"
                               BackgroundColor="{StaticResource SurfaceLighter}"/>

                        <Label Text="Target Date"
                               FontSize="13"
                               TextColor="{StaticResource TextMuted}"/>
                        <DatePicker x:Name="TargetDatePicker"
                                    FontSize="16"
                                    TextColor="{StaticResource TextPrimary}"/>

                        <Label Text="Initial Investment"
                               FontSize="13"
                               TextColor="{StaticResource TextMuted}"/>
                        <Entry x:Name="InitialInvestmentEntry"
                               Placeholder="$1,000"
                               Keyboard="Numeric"
                               FontSize="16"
                               TextColor="{StaticResource TextPrimary}"
                               BackgroundColor="{StaticResource SurfaceLighter}"/>

                        <Label Text="Monthly Contribution"
                               FontSize="13"
                               TextColor="{StaticResource TextMuted}"/>
                        <Entry x:Name="MonthlyContributionEntry"
                               Placeholder="$200"
                               Keyboard="Numeric"
                               FontSize="16"
                               TextColor="{StaticResource TextPrimary}"
                               BackgroundColor="{StaticResource SurfaceLighter}"/>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Navigation Buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="15" Margin="0,20,0,0">
            <Button Text="Back"
                    Style="{StaticResource SecondaryButton}"
                    Clicked="OnBackClicked"
                    Grid.Column="0"
                    HeightRequest="50"/>
            <Button x:Name="NextButton"
                    Text="Continue"
                    Style="{StaticResource PrimaryButton}"
                    Clicked="OnNextClicked"
                    Grid.Column="1"
                    HeightRequest="50"
                    IsEnabled="False"/>
        </Grid>

    </Grid>

</ContentPage>
