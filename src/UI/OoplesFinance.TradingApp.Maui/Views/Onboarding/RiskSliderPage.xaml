<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OoplesFinance.TradingApp.Maui.Views.Onboarding.RiskSliderPage"
             Title="Risk Level"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20">

        <!-- Progress Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="10" Margin="0,0,0,20">
            <Label Text="Step 3 of 3: Risk Level"
                   FontSize="14"
                   TextColor="{StaticResource TextMuted}"/>
            <ProgressBar Progress="1.0"
                         ProgressColor="{StaticResource Primary}"
                         HeightRequest="8"/>
        </VerticalStackLayout>

        <!-- Risk Slider Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="30">

                <Label Text="Choose Your Risk Level"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"
                       HorizontalTextAlignment="Center"/>

                <Label Text="This controls how aggressively the AI will trade on your behalf. You can change this anytime."
                       FontSize="14"
                       TextColor="{StaticResource TextMuted}"
                       HorizontalTextAlignment="Center"/>

                <!-- Risk Level Display -->
                <Border BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource BorderColor}"
                        StrokeThickness="1"
                        Padding="25">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="15"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="20">

                        <!-- Current Level -->
                        <Label x:Name="RiskLevelLabel"
                               Text="Moderate"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center"/>

                        <!-- Slider -->
                        <Slider x:Name="RiskSlider"
                                Minimum="1"
                                Maximum="5"
                                Value="3"
                                ValueChanged="OnRiskValueChanged"
                                MinimumTrackColor="{StaticResource Primary}"
                                MaximumTrackColor="{StaticResource BorderColor}"
                                ThumbColor="{StaticResource Primary}"/>

                        <!-- Labels -->
                        <Grid ColumnDefinitions="*,*,*,*,*">
                            <Label Text="Very Conservative"
                                   FontSize="10"
                                   TextColor="{StaticResource TextMuted}"
                                   HorizontalTextAlignment="Center"
                                   Grid.Column="0"/>
                            <Label Text="Conservative"
                                   FontSize="10"
                                   TextColor="{StaticResource TextMuted}"
                                   HorizontalTextAlignment="Center"
                                   Grid.Column="1"/>
                            <Label Text="Moderate"
                                   FontSize="10"
                                   TextColor="{StaticResource TextMuted}"
                                   HorizontalTextAlignment="Center"
                                   Grid.Column="2"/>
                            <Label Text="Aggressive"
                                   FontSize="10"
                                   TextColor="{StaticResource TextMuted}"
                                   HorizontalTextAlignment="Center"
                                   Grid.Column="3"/>
                            <Label Text="Very Aggressive"
                                   FontSize="10"
                                   TextColor="{StaticResource TextMuted}"
                                   HorizontalTextAlignment="Center"
                                   Grid.Column="4"/>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Portfolio Preview -->
                <Border BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource BorderColor}"
                        StrokeThickness="1"
                        Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="15"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="15">

                        <Label Text="Suggested Portfolio Allocation"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"/>

                        <!-- Stocks -->
                        <Grid ColumnDefinitions="*,Auto">
                            <HorizontalStackLayout Spacing="10">
                                <BoxView BackgroundColor="{StaticResource Primary}"
                                         WidthRequest="16"
                                         HeightRequest="16"
                                         CornerRadius="3"/>
                                <Label Text="Stocks"
                                       FontSize="14"
                                       TextColor="{StaticResource TextPrimary}"/>
                            </HorizontalStackLayout>
                            <Label x:Name="StocksPercentLabel"
                                   Text="60%"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   Grid.Column="1"/>
                        </Grid>
                        <ProgressBar x:Name="StocksBar"
                                     Progress="0.6"
                                     ProgressColor="{StaticResource Primary}"
                                     HeightRequest="6"/>

                        <!-- Bonds -->
                        <Grid ColumnDefinitions="*,Auto">
                            <HorizontalStackLayout Spacing="10">
                                <BoxView BackgroundColor="{StaticResource Warning}"
                                         WidthRequest="16"
                                         HeightRequest="16"
                                         CornerRadius="3"/>
                                <Label Text="Bonds"
                                       FontSize="14"
                                       TextColor="{StaticResource TextPrimary}"/>
                            </HorizontalStackLayout>
                            <Label x:Name="BondsPercentLabel"
                                   Text="30%"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   Grid.Column="1"/>
                        </Grid>
                        <ProgressBar x:Name="BondsBar"
                                     Progress="0.3"
                                     ProgressColor="{StaticResource Warning}"
                                     HeightRequest="6"/>

                        <!-- Cash -->
                        <Grid ColumnDefinitions="*,Auto">
                            <HorizontalStackLayout Spacing="10">
                                <BoxView BackgroundColor="{StaticResource TextMuted}"
                                         WidthRequest="16"
                                         HeightRequest="16"
                                         CornerRadius="3"/>
                                <Label Text="Cash"
                                       FontSize="14"
                                       TextColor="{StaticResource TextPrimary}"/>
                            </HorizontalStackLayout>
                            <Label x:Name="CashPercentLabel"
                                   Text="10%"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   Grid.Column="1"/>
                        </Grid>
                        <ProgressBar x:Name="CashBar"
                                     Progress="0.1"
                                     ProgressColor="{StaticResource TextMuted}"
                                     HeightRequest="6"/>

                    </VerticalStackLayout>
                </Border>

                <!-- Historical Performance -->
                <Border BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource BorderColor}"
                        StrokeThickness="1"
                        Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="15"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">

                        <Label Text="Historical Performance (10 years)"
                               FontSize="14"
                               TextColor="{StaticResource TextMuted}"/>

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label x:Name="AvgReturnLabel"
                                       Text="+7.2%"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Success}"/>
                                <Label Text="Avg. Annual Return"
                                       FontSize="12"
                                       TextColor="{StaticResource TextMuted}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label x:Name="MaxDrawdownLabel"
                                       Text="-15%"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Danger}"/>
                                <Label Text="Max Drawdown"
                                       FontSize="12"
                                       TextColor="{StaticResource TextMuted}"/>
                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Navigation Buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="15" Margin="0,20,0,0">
            <Button Text="Back"
                    Style="{StaticResource SecondaryButton}"
                    Clicked="OnBackClicked"
                    Grid.Column="0"/>
            <Button Text="Start Trading"
                    Style="{StaticResource PrimaryButton}"
                    Clicked="OnStartTradingClicked"
                    Grid.Column="1"/>
        </Grid>

    </Grid>

</ContentPage>
