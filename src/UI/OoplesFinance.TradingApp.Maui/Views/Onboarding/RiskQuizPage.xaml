<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OoplesFinance.TradingApp.Maui.Views.Onboarding.RiskQuizPage"
             Title="Risk Assessment"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20">

        <!-- Progress Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="10" Margin="0,0,0,20">
            <Label Text="Step 1 of 3: Risk Assessment"
                   FontSize="14"
                   TextColor="{StaticResource TextMuted}"/>
            <ProgressBar x:Name="ProgressBar"
                         Progress="0.33"
                         ProgressColor="{StaticResource Primary}"
                         HeightRequest="6"/>
            <Label x:Name="QuestionCounter"
                   Text="Question 1 of 5"
                   FontSize="12"
                   TextColor="{StaticResource TextMuted}"
                   HorizontalOptions="End"/>
        </VerticalStackLayout>

        <!-- Questions Carousel -->
        <CarouselView x:Name="QuestionsCarousel"
                      Grid.Row="1"
                      Loop="False"
                      IsSwipeEnabled="False"
                      CurrentItemChanged="OnCurrentItemChanged">
            <CarouselView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}"
                            Margin="10"
                            Padding="25">
                        <VerticalStackLayout Spacing="25">

                            <Label Text="{Binding Question}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   HorizontalTextAlignment="Center"/>

                            <!-- Answer Options -->
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Options}"
                                                 Spacing="12">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border BackgroundColor="{StaticResource Surface}"
                                                Stroke="{StaticResource BorderColor}"
                                                StrokeThickness="1"
                                                Padding="15">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10"/>
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SelectCommand}"
                                                                      CommandParameter="{Binding .}"/>
                                            </Border.GestureRecognizers>
                                            <HorizontalStackLayout Spacing="15">
                                                <Border BackgroundColor="Transparent"
                                                        Stroke="{StaticResource BorderColor}"
                                                        StrokeThickness="2"
                                                        WidthRequest="24"
                                                        HeightRequest="24">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="12"/>
                                                    </Border.StrokeShape>
                                                </Border>
                                                <Label Text="{Binding Text}"
                                                       FontSize="15"
                                                       TextColor="{StaticResource TextPrimary}"
                                                       VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <!-- Navigation Buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="15" Margin="0,20,0,0">
            <Button x:Name="BackButton"
                    Text="Back"
                    Style="{StaticResource SecondaryButton}"
                    Clicked="OnBackClicked"
                    Grid.Column="0"
                    HeightRequest="50"
                    IsVisible="False"/>
            <Button x:Name="NextButton"
                    Text="Next"
                    Style="{StaticResource PrimaryButton}"
                    Clicked="OnNextClicked"
                    Grid.Column="1"
                    HeightRequest="50"/>
        </Grid>

    </Grid>

</ContentPage>
