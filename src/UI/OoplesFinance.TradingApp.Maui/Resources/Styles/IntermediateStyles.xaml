<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
    INTERMEDIATE MODE STYLES
    Standard trading UI, most features available, balanced information density
    Target: Investors with some experience, familiar with basic trading concepts
    -->

    <!-- Standard Buttons -->
    <Style x:Key="IntermediateButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="HeightRequest" Value="48"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="16,10"/>
    </Style>

    <Style x:Key="IntermediateSecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="BorderColor" Value="{StaticResource BorderColor}"/>
        <Setter Property="BorderWidth" Value="1"/>
        <Setter Property="TextColor" Value="{StaticResource TextColor}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="HeightRequest" Value="44"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style x:Key="IntermediateSmallButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="HeightRequest" Value="36"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12,6"/>
    </Style>

    <!-- Standard Text Styles -->
    <Style x:Key="IntermediateTitle" TargetType="Label">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{StaticResource TextColor}"/>
    </Style>

    <Style x:Key="IntermediateSubtitle" TargetType="Label">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="TextColor" Value="{StaticResource SecondaryTextColor}"/>
    </Style>

    <Style x:Key="IntermediateBodyText" TargetType="Label">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextColor" Value="{StaticResource TextColor}"/>
    </Style>

    <Style x:Key="IntermediateSmallText" TargetType="Label">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextColor" Value="{StaticResource SecondaryTextColor}"/>
    </Style>

    <!-- Standard Cards -->
    <Style x:Key="IntermediateCard" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource CardBackgroundColor}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="8"/>
        <Setter Property="HasShadow" Value="True"/>
    </Style>

    <Style x:Key="IntermediateCompactCard" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource CardBackgroundColor}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="4"/>
    </Style>

    <!-- Data Display -->
    <Style x:Key="IntermediateValueDisplay" TargetType="Label">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{StaticResource TextColor}"/>
    </Style>

    <Style x:Key="IntermediatePositiveValue" TargetType="Label">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{StaticResource SuccessColor}"/>
    </Style>

    <Style x:Key="IntermediateNegativeValue" TargetType="Label">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{StaticResource ErrorColor}"/>
    </Style>

    <!-- Data Labels -->
    <Style x:Key="IntermediateDataLabel" TargetType="Label">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextColor" Value="{StaticResource SecondaryTextColor}"/>
        <Setter Property="TextTransform" Value="Uppercase"/>
    </Style>

    <Style x:Key="IntermediateDataValue" TargetType="Label">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{StaticResource TextColor}"/>
    </Style>

    <!-- Entry Fields -->
    <Style x:Key="IntermediateEntry" TargetType="Entry">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="HeightRequest" Value="44"/>
        <Setter Property="TextColor" Value="{StaticResource TextColor}"/>
        <Setter Property="BackgroundColor" Value="{StaticResource CardBackgroundColor}"/>
    </Style>

    <!-- Table/Grid Styles -->
    <Style x:Key="IntermediateTableHeader" TargetType="Label">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{StaticResource SecondaryTextColor}"/>
        <Setter Property="TextTransform" Value="Uppercase"/>
    </Style>

    <Style x:Key="IntermediateTableCell" TargetType="Label">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextColor" Value="{StaticResource TextColor}"/>
        <Setter Property="VerticalOptions" Value="Center"/>
    </Style>

    <!-- Indicators and Badges -->
    <Style x:Key="IntermediateBadge" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="HasShadow" Value="False"/>
    </Style>

    <Style x:Key="IntermediateStatusPill" TargetType="Frame">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="HasShadow" Value="False"/>
    </Style>

    <!-- Charts and Data Visualization -->
    <Style x:Key="IntermediateChartContainer" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource CardBackgroundColor}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="HeightRequest" Value="250"/>
    </Style>

    <!-- Toolbar Items -->
    <Style x:Key="IntermediateToolbarButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{StaticResource TextColor}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,5"/>
    </Style>

</ResourceDictionary>
