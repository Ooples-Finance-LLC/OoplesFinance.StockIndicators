<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="OoplesFinance.TradingApp.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:OoplesFinance.TradingApp.Maui.Views"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="{StaticResource Surface}"
    Shell.TabBarTitleColor="{StaticResource TextMuted}"
    Shell.TabBarUnselectedColor="{StaticResource TextMuted}"
    Shell.TabBarForegroundColor="{StaticResource Primary}">

    <!-- Tab Bar Navigation for Mobile -->
    <TabBar>
        <ShellContent
            Title="Dashboard"
            Icon="dashboard.png"
            ContentTemplate="{DataTemplate views:DashboardPage}"
            Route="dashboard"/>

        <ShellContent
            Title="Positions"
            Icon="positions.png"
            ContentTemplate="{DataTemplate views:PositionsPage}"
            Route="positions"/>

        <ShellContent
            Title="Trade"
            Icon="trade.png"
            ContentTemplate="{DataTemplate views:OrderEntryPage}"
            Route="trade"/>

        <ShellContent
            Title="Watchlist"
            Icon="watchlist.png"
            ContentTemplate="{DataTemplate views:WatchlistPage}"
            Route="watchlist"/>

        <ShellContent
            Title="More"
            Icon="more.png"
            ContentTemplate="{DataTemplate views:SettingsPage}"
            Route="settings"/>
    </TabBar>

</Shell>
