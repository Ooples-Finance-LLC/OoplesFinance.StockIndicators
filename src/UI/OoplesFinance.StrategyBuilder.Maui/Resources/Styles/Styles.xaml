<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Value Converters -->
    <local:InvertedBoolConverter x:Key="InvertedBoolConverter" xmlns:local="clr-namespace:OoplesFinance.StrategyBuilder.Maui.Converters"/>
    <local:DirectionColorConverter x:Key="DirectionColorConverter" xmlns:local="clr-namespace:OoplesFinance.StrategyBuilder.Maui.Converters"/>
    <local:ProfitLossColorConverter x:Key="ProfitLossColorConverter" xmlns:local="clr-namespace:OoplesFinance.StrategyBuilder.Maui.Converters"/>

    <!-- Toolbar Button Style -->
    <Style x:Key="ToolbarButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#3E3E42"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="#3E3E42"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="#007ACC"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="#505050"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="#2D2D30"/>
                            <Setter Property="TextColor" Value="#666666"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Primary Button Style -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#007ACC"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="CornerRadius" Value="5"/>
    </Style>

    <!-- Danger Button Style -->
    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#8B0000"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="CornerRadius" Value="3"/>
    </Style>

    <!-- Entry Style -->
    <Style TargetType="Entry">
        <Setter Property="BackgroundColor" Value="#3E3E42"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="PlaceholderColor" Value="#888888"/>
    </Style>

    <!-- SearchBar Style -->
    <Style TargetType="SearchBar">
        <Setter Property="BackgroundColor" Value="#3E3E42"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="PlaceholderColor" Value="#888888"/>
        <Setter Property="CancelButtonColor" Value="#888888"/>
    </Style>

    <!-- Label Styles -->
    <Style x:Key="HeaderLabel" TargetType="Label">
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>

    <Style x:Key="SubheaderLabel" TargetType="Label">
        <Setter Property="TextColor" Value="#CCCCCC"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style x:Key="MutedLabel" TargetType="Label">
        <Setter Property="TextColor" Value="#888888"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- Panel Border Style -->
    <Style x:Key="PanelBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="#252526"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- Card Style -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="#2D2D30"/>
        <Setter Property="Stroke" Value="#3E3E42"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 5"/>
        <Setter Property="Padding" Value="15"/>
    </Style>

</ResourceDictionary>
